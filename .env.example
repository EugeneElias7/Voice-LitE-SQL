# Copy to .env for LOCAL dev only. Never commit .env. Production keys go in
# Render Dashboard > Environment and Vercel > Settings > Environment Variables.
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_KEY=sk-or-v1-paste-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FAKE_EMBEDDER=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATABASE_PATH=backend/data/enterprise.db
INDEX_DIR=evaluation/index
SEED_DB_ON_STARTUP=true

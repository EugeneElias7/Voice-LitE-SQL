# OLLAMA_MODEL=qwen2.5-coder:1.5b
# Frontend (Vercel): VITE_API_BASE=https://voice-lite-sql-api.onrender.com/api
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
